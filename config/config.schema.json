{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://shadow-pr-review.local/config/config.schema.json",
  "title": "SprConfig",
  "description": "Tool configuration: config/default.json merged with SPR_* environment variables. Secrets never live here.",
  "type": "object",
  "additionalProperties": false,
  "required": ["llm", "budgets", "ingest", "review", "narration", "tts", "video", "runs", "cache"],
  "properties": {
    "llm": {
      "type": "object",
      "additionalProperties": false,
      "required": ["provider", "model", "maxRetries", "temperature"],
      "properties": {
        "provider": { "enum": ["anthropic", "ollama", "fake"] },
        "model": { "type": "string", "minLength": 1 },
        "models": {
          "type": "object",
          "additionalProperties": false,
          "description": "Per-stage overrides of llm.model (ADR-057). A stage with no entry uses llm.model, so one model everywhere stays the default.",
          "properties": {
            "review": { "type": "string", "minLength": 1 },
            "verify": { "type": "string", "minLength": 1 },
            "narrate": { "type": "string", "minLength": 1 }
          }
        },
        "baseUrl": { "type": "string" },
        "effort": {
          "enum": ["low", "medium", "high", "xhigh", "max"],
          "description": "Reasoning effort. Only the hosted Anthropic provider uses this; Ollama ignores it."
        },
        "think": {
          "type": "boolean",
          "description": "Let an Ollama model think before answering. Default true (ADR-021): equal recall, better grounding, about 15 times the wall clock. Set SPR_LLM_THINK=false when iterating on prompts."
        },
        "maxRetries": { "type": "integer", "minimum": 0, "maximum": 5 },
        "temperature": { "type": "number", "minimum": 0, "maximum": 1 }
      }
    },
    "budgets": {
      "type": "object",
      "additionalProperties": false,
      "required": ["inputTokens", "outputTokens", "toolCalls", "agentSteps", "wallClockSeconds"],
      "properties": {
        "inputTokens": { "type": "integer", "minimum": 1 },
        "outputTokens": { "type": "integer", "minimum": 1 },
        "toolCalls": { "type": "integer", "minimum": 0 },
        "agentSteps": { "type": "integer", "minimum": 1 },
        "wallClockSeconds": { "type": "integer", "minimum": 1 }
      }
    },
    "ingest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ignoreGlobs", "maxFileBytes", "maxDiffBytes"],
      "properties": {
        "ignoreGlobs": { "type": "array", "items": { "type": "string" } },
        "maxFileBytes": { "type": "integer", "minimum": 1 },
        "maxDiffBytes": { "type": "integer", "minimum": 1 }
      }
    },
    "review": {
      "type": "object",
      "additionalProperties": false,
      "required": ["maxRawFindings", "maxFindings"],
      "properties": {
        "maxRawFindings": { "type": "integer", "minimum": 1 },
        "maxFindings": { "type": "integer", "minimum": 0, "maximum": 10 }
      }
    },
    "narration": {
      "type": "object",
      "additionalProperties": false,
      "required": ["maxWordsPerStep", "language"],
      "properties": {
        "maxWordsPerStep": {
          "type": "integer",
          "minimum": 40,
          "description": "Spoken words per narration step. The floor is 40 because checkScript also holds an intro or a wrap-up to 15 to 40 words (NARRATION_STYLE.md); a lower cap here would make those two rules contradict, and the Narrator could never satisfy both."
        },
        "language": { "type": "string" }
      }
    },
    "tts": {
      "type": "object",
      "additionalProperties": false,
      "required": ["provider", "baseUrl", "voice", "speed"],
      "properties": {
        "provider": { "enum": ["kokoro-http", "piper", "fake"] },
        "baseUrl": { "type": "string" },
        "voice": { "type": "string", "minLength": 1 },
        "speed": { "type": "number", "minimum": 0.5, "maximum": 2 }
      }
    },
    "video": {
      "type": "object",
      "additionalProperties": false,
      "required": ["width", "height", "theme", "gapMs", "subtitles"],
      "properties": {
        "width": { "type": "integer", "minimum": 320 },
        "height": { "type": "integer", "minimum": 240 },
        "theme": { "enum": ["light", "dark"] },
        "gapMs": { "type": "integer", "minimum": 0 },
        "subtitles": { "enum": ["off", "sidecar", "burn"] }
      }
    },
    "runs": {
      "type": "object",
      "additionalProperties": false,
      "required": ["dir"],
      "properties": {
        "dir": { "type": "string", "minLength": 1 }
      }
    },
    "cache": {
      "type": "object",
      "additionalProperties": false,
      "required": ["enabled", "dir"],
      "description": "On-disk cache of LLM and TTS responses, keyed by a hash of the request. Shared across runs, so re-running a stage costs nothing.",
      "properties": {
        "enabled": { "type": "boolean" },
        "dir": { "type": "string", "minLength": 1 }
      }
    }
  }
}
