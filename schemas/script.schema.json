{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://shadow-pr-review.local/schemas/script.schema.json",
  "title": "NarrationScript",
  "description": "Contract for script.json. Produced by the Narrator agent from verified findings. Code-level validators must additionally enforce: first step is intro, last step is wrap_up, every finding step references a finding id present in review.json, and focus matches that finding's location.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "title", "steps"],
  "properties": {
    "schema_version": { "const": "1.0" },
    "title": { "type": "string", "minLength": 1, "maxLength": 100, "description": "Shown on the title card." },
    "language": { "type": "string", "default": "en-US" },
    "steps": {
      "type": "array",
      "minItems": 2,
      "maxItems": 12,
      "items": { "$ref": "#/$defs/Step" }
    }
  },
  "$defs": {
    "Step": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "kind", "finding_id", "text", "focus"],
      "properties": {
        "id": { "type": "string", "pattern": "^S[0-9]{2}$" },
        "kind": { "enum": ["intro", "finding", "wrap_up"] },
        "finding_id": { "type": ["string", "null"], "pattern": "^F[0-9]{2}$" },
        "text": {
          "type": "string",
          "minLength": 1,
          "maxLength": 450,
          "description": "Spoken text. Plain sentences only: no markdown, no code blocks, no file extensions read aloud. Target at most ~60 words (~25 seconds)."
        },
        "subtitle": {
          "type": ["string", "null"],
          "description": "Optional on-screen text if it should differ from the spoken text. Defaults to text."
        },
        "focus": {
          "oneOf": [
            { "type": "null" },
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["file", "side", "line_start", "line_end"],
              "properties": {
                "file": { "type": "string" },
                "side": { "enum": ["new", "old"] },
                "line_start": { "type": "integer", "minimum": 1 },
                "line_end": { "type": "integer", "minimum": 1 }
              }
            }
          ]
        },
        "estimated_seconds": { "type": "number", "minimum": 0, "description": "Word count / 2.5. Informational; real durations come from the TTS stage." }
      }
    }
  }
}
