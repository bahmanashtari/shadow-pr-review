{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://shadow-pr-review.local/schemas/timeline.schema.json",
  "title": "Timeline",
  "description": "Contract for timeline.json. Produced deterministically by the Director from script.json + audio/manifest.json. The Recorder executes actions in order; the Composer uses step_windows to place audio and subtitles. All times are relative to the moment the Recorder marks t=0 (after the page has loaded).",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "render_mode", "video", "gap_ms", "total_duration_ms", "step_windows", "actions"],
  "properties": {
    "schema_version": { "const": "1.0" },
    "render_mode": { "enum": ["diff2html", "github"] },
    "video": {
      "type": "object",
      "additionalProperties": false,
      "required": ["width", "height"],
      "properties": {
        "width": { "type": "integer", "default": 1280 },
        "height": { "type": "integer", "default": 720 },
        "theme": { "enum": ["light", "dark"], "default": "dark" }
      }
    },
    "gap_ms": { "type": "integer", "minimum": 0, "description": "Silence inserted between steps." },
    "total_duration_ms": { "type": "integer", "minimum": 1 },
    "step_windows": {
      "type": "array",
      "description": "When each step's audio plays. start_ms of step n+1 = end_ms of step n + gap_ms.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["step_id", "start_ms", "end_ms"],
        "properties": {
          "step_id": { "type": "string", "pattern": "^S[0-9]{2}$" },
          "start_ms": { "type": "integer", "minimum": 0 },
          "end_ms": { "type": "integer", "minimum": 0 }
        }
      }
    },
    "actions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["at_ms", "step_id", "type"],
        "properties": {
          "at_ms": { "type": "integer", "minimum": 0 },
          "step_id": { "type": "string", "pattern": "^S[0-9]{2}$" },
          "type": { "enum": ["show_title", "hide_title", "open_file", "scroll_to", "highlight", "clear_highlight", "show_outro"] },
          "file": { "type": "string" },
          "side": { "enum": ["new", "old"] },
          "line_start": { "type": "integer", "minimum": 1 },
          "line_end": { "type": "integer", "minimum": 1 },
          "text": { "type": "string" },
          "animation_ms": { "type": "integer", "minimum": 0, "default": 400 }
        }
      }
    }
  }
}
