 import { JwtAuthGuard } from '../auth/jwt-auth.guard';
 import { CustomerRepository } from '../../infrastructure/persistence/customer.repository';
 
 @Controller('customers')
 export class CustomerController {
   constructor(private readonly customers: CustomerRepository) {}
 
   @UseGuards(JwtAuthGuard)
   @Get(':id')
   async byId(@Param('id') id: string) {
     return this.customers.findById(id);
   }
+
+  @Get('search')
+  async search(@Query('q') q: string) {
+    return this.customers.searchByName(q);
+  }
 }
diff --git a/services/customer-service/src/infrastructure/persistence/customer.repository.ts b/services/customer-service/src/infrastructure/persistence/customer.repository.ts
