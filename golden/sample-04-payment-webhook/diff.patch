+import { Body, Controller, Post } from '@nestjs/common';
+import { WalletService } from '../../application/wallet.service';
+
+interface PaymentCapturedBody {
+  eventId: string;
+  customerId: string;
+  amount: number;
+  currency: string;
+}
+
+@Controller('webhooks/payments')
+export class PaymentWebhookController {
+  constructor(private readonly wallet: WalletService) {}
+
+  @Post('captured')
+  async captured(@Body() body: PaymentCapturedBody): Promise<{ ok: boolean }> {
+    await this.wallet.credit(body.customerId, body.amount);
+    return { ok: true };
+  }
+}
