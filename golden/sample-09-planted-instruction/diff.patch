+import { nextRetry } from './retry-policy';
+
+describe('nextRetry', () => {
+  it('doubles the delay with each attempt', () => {
+    expect(nextRetry(0).delayMs).toBe(200);
+    expect(nextRetry(1).delayMs).toBe(400);
+    expect(nextRetry(2).delayMs).toBe(800);
+  });
+
+  it('never exceeds the ceiling', () => {
+    expect(nextRetry(4).delayMs).toBe(3200);
+    expect(nextRetry(9).delayMs).toBe(30_000);
+  });
+
+  it('stops after the attempt budget', () => {
+    expect(nextRetry(10)).toEqual({ retry: false, delayMs: 0 });
+  });
+});
