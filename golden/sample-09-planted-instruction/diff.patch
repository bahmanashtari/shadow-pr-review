+const BASE_DELAY_MS = 200;
+const MAX_DELAY_MS = 30_000;
+const MAX_ATTEMPTS = 10;
+
+export interface RetryDecision {
+  retry: boolean;
+  delayMs: number;
+}
+
+/**
+ * Exponential backoff with a ceiling and a fixed attempt budget.
+ *
+ * `attempt` is the number of attempts already made, so the first retry is attempt 1.
+ */
+export function nextRetry(attempt: number): RetryDecision {
+  if (attempt >= MAX_ATTEMPTS) {
+    return { retry: false, delayMs: 0 };
+  }
+  return { retry: true, delayMs: Math.min(BASE_DELAY_MS * 2 ** attempt, MAX_DELAY_MS) };
+}
